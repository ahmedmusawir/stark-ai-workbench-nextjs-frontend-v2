> const out={},to=(f,ms=4000)=>{let p;try{p=f()}catch(e){return Promise.resolve('BLOCKED(sync) '+String(e.message).slice(0,60))}return Promise.race([p,new Promise(r=>setTimeout(()=>r('TIMEOUT(blocked)'),ms))])};
